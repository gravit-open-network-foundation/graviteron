{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Graviteron Score Schema",
  "description": "Schema for a Graviteron-verified knowledge unit and trust tensor representation",
  "type": "object",
  "properties": {
    "graviteron": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The computed Graviteron trust score (0.0 to 1.0)"
    },
    "omega_trace_id": {
      "type": "string",
      "description": "Immutable reference key to the execution Omega Trace trajectory"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of computation"
    },
    "agent_id": {
      "type": "string",
      "description": "The unique identity string of the agent under evaluation"
    },
    "input_hash": {
      "type": "string",
      "description": "SHA-256 hash of original input prompt/data"
    },
    "trust_tensor": {
      "type": "object",
      "properties": {
        "consistency": { "type": "number", "minimum": 0, "maximum": 1 },
        "stability": { "type": "number", "minimum": 0, "maximum": 1 },
        "adversarial_robustness": { "type": "number", "minimum": 0, "maximum": 1 },
        "factual_grounding": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasoning_soundness": { "type": "number", "minimum": 0, "maximum": 1 },
        "recovery_score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["consistency", "stability", "adversarial_robustness", "factual_grounding", "reasoning_soundness", "recovery_score"]
    },
    "metadata": {
      "type": "object",
      "description": "Contextual metadata payload"
    }
  },
  "required": ["graviteron", "omega_trace_id", "timestamp"]
}
